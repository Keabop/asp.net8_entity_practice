@*
    VISTA: Edit (formulario para editar un área existente)
    ---------------------------------------------------------------------------
    Es casi idéntica a Create, con UNA diferencia clave: incluimos un campo
    OCULTO con el Id. Así, al enviar, el servidor sabe QUÉ fila actualizar.
*@
@model CapacitacionRH.Models.Area

@{
    ViewData["Title"] = "Editar área";
}

<h1>Editar área</h1>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* Campo oculto: viaja el Id sin mostrarse en pantalla. Imprescindible
       para que el UPDATE sepa a qué registro corresponde. *@
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
